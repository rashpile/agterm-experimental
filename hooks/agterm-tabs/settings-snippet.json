{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/agterm-tabs/register-tab.sh start",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/agterm-tabs/register-tab.sh end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
