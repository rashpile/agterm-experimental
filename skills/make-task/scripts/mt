import yaml

PHASES = [
    ("brainstorm", "Brainstorm"),
    ("plan", "Plan"),
    ("exec", "Execute"),
    ("review", "Review"),
    ("finalize", "Finalize"),
]
PHASE_IDS = [p[0] for p in PHASES]

SET_KEYS = (
    "mode",
    "revmux_task",
    "revmux_tasks_dir",
    "review_base",
    "loop_start_sha",
    "reviewed_sha",
    "stop_reason",
    "stash_ref",
    "stash_restored",
    "worktree_path",
)
# keys an empty VALUE may clear; for the others an empty value is a failed $(...) and is refused
CLEARABLE_KEYS = ("stash_ref", "worktree_path")
# keys set once: a second, different value is refused (reviewed_sha set again after finalize would vouch
# for the finalizer's own commits)
WRITE_ONCE_KEYS = ("reviewed_sha",)
SET_CHOICES = {
    "mode": ("worktree", "inplace"),
    "stop_reason": ("clean", "not-converging", "round-cap", "degraded", "skipped"),
    # the Completion step 3 restore outcome that put the user's stash_paths back (`conflict` puts nothing back)
    "stash_restored": ("ok", "gone", "none"),
}
# a checkpoint key, profile name, companion id, or a plugin's name or marketplace
ID = r"[A-Za-z0-9][A-Za-z0-9._-]*"
